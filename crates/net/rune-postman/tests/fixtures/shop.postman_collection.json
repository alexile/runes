				{
					"name": "Legacy digest",
					"request": {
						"auth": {
							"type": "digest",
							"digest": [
								{
									"key": "username",
									"value": "legacy",
									"type": "string"
								},
								{
									"key": "password",
									"value": "not-a-real-password",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/partners/legacy",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
