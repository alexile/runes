{
  "swagger": "2.0",
  "info": { "title": "Store (fixture)", "version": "1.0" },
  "host": "store.example.test",
  "basePath": "/v2",
  "schemes": ["https", "http"],
  "consumes": ["application/json"],
  "securityDefinitions": {
    "api_key": { "type": "apiKey", "name": "api_key", "in": "query" },
    "basic": { "type": "basic" }
  },
  "paths": {
    "/store/order": {
      "post": {
        "operationId": "placeOrder",
        "tags": ["store"],
        "security": [ { "api_key": [] } ],
        "parameters": [
          { "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/Order" } }
        ],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/store/order/{orderId}": {
      "get": {
        "operationId": "getOrderById",
        "tags": ["store"],
        "parameters": [
          { "name": "orderId", "in": "path", "required": true, "type": "integer", "format": "int64", "minimum": 1, "maximum": 10 }
        ],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/user/login": {
      "get": {
        "operationId": "loginUser",
        "tags": ["user"],
        "security": [ { "basic": [] } ],
        "parameters": [
          { "name": "username", "in": "query", "required": true, "type": "string", "x-example": "alice" },
          { "name": "tags", "in": "query", "type": "array", "items": { "type": "string", "enum": ["a", "b"] }, "collectionFormat": "multi" }
        ],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/pet/{petId}/uploadImage": {
      "post": {
        "operationId": "uploadFile",
        "tags": ["pet"],
        "consumes": ["multipart/form-data"],
        "parameters": [
          { "name": "petId", "in": "path", "required": true, "type": "integer", "format": "int64" },
          { "name": "additionalMetadata", "in": "formData", "type": "string", "default": "meta" },
          { "name": "file", "in": "formData", "type": "file" }
        ],
        "responses": { "200": { "description": "ok" } }
      }
    }
  },
  "definitions": {
    "Order": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "format": "int64" },
        "petId": { "type": "integer", "format": "int64" },
        "quantity": { "type": "integer", "format": "int32", "default": 2 },
        "shipDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["placed", "approved", "delivered"] },
        "complete": { "type": "boolean" }
      }
    }
  }
}
