{
  "openapi": "3.1.0",
  "info": { "title": "Users (fixture)", "version": "2.0.0" },
  "servers": [
    {
      "url": "https://{region}.api.example.test/{basePath}",
      "variables": {
        "region": { "default": "eu", "enum": ["eu", "us"] },
        "basePath": { "default": "v2" }
      }
    }
  ],
  "paths": {
    "/users/{userId}": {
      "get": {
        "operationId": "getUser",
        "tags": ["users"],
        "parameters": [
          { "name": "userId", "in": "path", "required": true,
            "schema": { "type": "integer", "format": "int64", "exclusiveMinimum": 0 } },
          { "name": "session", "in": "cookie", "schema": { "type": "string" }, "example": "cookie-value-1" },
          { "name": "filter", "in": "query", "style": "deepObject",
            "schema": { "type": "object", "properties": { "role": { "type": "string", "const": "admin" } } } }
        ],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/users": {
      "post": {
        "operationId": "createUser",
        "tags": ["users"],
        "security": [ { "oauth": ["users:write"] } ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/User" }
            },
            "application/xml": {
              "schema": { "$ref": "#/components/schemas/User" }
            }
          }
        },
        "responses": { "201": { "description": "created" } }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "nickname": { "type": ["string", "null"], "examples": ["nick-1"] },
          "age": { "type": "integer", "minimum": 18 },
          "score": { "type": "number", "exclusiveMinimum": 2.5 },
          "kind": { "oneOf": [ { "type": "string", "enum": ["person", "bot"] }, { "type": "integer" } ] }
        }
      }
    },
    "securitySchemes": {
      "oauth": {
        "type": "oauth2",
        "flows": { "clientCredentials": { "tokenUrl": "https://auth.example.test/token", "scopes": { "users:write": "write" } } }
      }
    }
  },
  "webhooks": {}
}
