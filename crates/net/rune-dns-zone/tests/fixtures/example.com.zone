; BIND-style zone exercising the master-file features (RFC 1035 §5).
$TTL 1h
$ORIGIN example.com.
@               IN  SOA   ns1.example.com. hostmaster (
                          2026111101 ; serial
                          2h         ; refresh
                          15m        ; retry
                          2w         ; expire
                          5m )       ; negative caching TTL
                IN  NS    ns1
                IN  NS    ns2.example.net.
                IN  MX    10 mail
                IN  MX    20 mail.backup.example.net.
                IN  TXT   "v=spf1 mx include:_spf.example.net -all"
                IN  CAA   0 issue "letsencrypt.org"
                IN  CAA   0 iodef "mailto:security@example.com"
@         86400 IN  DNSKEY 257 3 13 (
                          mdsswUyr3DPW132mOi8V9xESWE8jTo0d
                          xCjjnopKl+GqJxpVXckHAeF+KkxLbxIL
                          fDLUT0rAK9iUzy1L53eKGQ== )
                IN  RRSIG SOA 13 2 3600 20261211000000 20261111000000 (
                          2371 example.com.
                          oJB1W6WNGv+ldvQ3WDG0MQkg5IEhjRip8WTr
                          PYGv07h108dUKGMeDPKijVCHX3DDKdfb+v6o
                          B9wfuh3DTJXUAfI/M0zmO/zz8bW0Rznl8O3t
                          GNazPwQKkRN20XPXV6nwwfoXmJQbsLNrLfkG
                          J5D6fwFm8nN+6pBzeDQfsS3Ap3o= )
                IN  NSEC3PARAM 1 0 0 -
ns1             IN  A     192.0.2.53
                IN  AAAA  2001:db8::53
mail       300  IN  A     192.0.2.25
mail       IN   300 AAAA  2001:db8::25
www             IN  CNAME @
_sip._tcp       IN  SRV   0 5 5060 sip
sip             IN  A     192.0.2.80
                IN  NAPTR 100 10 "S" "SIP+D2U" "" _sip._udp
_25._tcp.mail   IN  TLSA  3 1 1 (
                          0C72AC70B745AC19998811B131D662C9
                          AC69DBDBE7CB23E5B514B56664C5D3D6 )
host            IN  SSHFP 4 2 0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF
office          IN  LOC   52 22 23.000 N 4 53 32.000 E -2.00m 1m 10000m 10m
info            IN  HINFO "PC-Intel-700mhz" "Ubuntu \"Linux\""
legacy          IN  TYPE65280 \# 4 0A000001
1.2.0.192.in-addr.arpa. IN PTR www
k0vgi9cvr3tr9ugf4am3ssi8dqvpjsqp IN NSEC3 1 0 0 - (
                          2T7B4G4VSA5SMI47K61MV5BV1A22BOJR
                          A NS SOA MX TXT AAAA RRSIG DNSKEY NSEC3PARAM CAA )
$INCLUDE lan.inc lan
after-include   IN  TXT   "origin restored" "second string" \"unquoted\"
