{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "sast-tool",
          "semanticVersion": "0.4.0",
          "rules": [
            {
              "id": "python.sqli.format",
              "shortDescription": { "text": "SQL built with string formatting" },
              "properties": { "security-severity": "8.0", "tags": ["security", "external/cwe/cwe-089"] }
            },
            {
              "id": "python.xss.template-unescaped",
              "shortDescription": { "text": "Unescaped template output" },
              "properties": { "security-severity": "6.1", "tags": ["security", "external/cwe/cwe-079"] }
            },
            {
              "id": "generic.secret.hardcoded",
              "shortDescription": { "text": "Hard-coded credential" },
              "properties": { "security-severity": "7.5", "tags": ["security", "external/cwe/cwe-798"] }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "python.sqli.format",
          "level": "error",
          "message": { "text": "SQL built with string formatting from request input" },
          "locations": [
            { "physicalLocation": { "artifactLocation": { "uri": "src/db.py" }, "region": { "startLine": 42, "startColumn": 5, "endColumn": 61 } } }
          ],
          "partialFingerprints": { "primaryLocationLineHash": "5d2f8a1c0e7b4a93:1" },
          "codeFlows": [
            {
              "threadFlows": [
                {
                  "locations": [
                    { "location": { "physicalLocation": { "artifactLocation": { "uri": "src/users.py" }, "region": { "startLine": 12 } }, "message": { "text": "request.args['id']" } } },
                    { "location": { "physicalLocation": { "artifactLocation": { "uri": "src/db.py" }, "region": { "startLine": 42 } }, "message": { "text": "cursor.execute" } } }
                  ]
                }
              ]
            }
          ]
        },
        {
          "ruleId": "python.xss.template-unescaped",
          "level": "warning",
          "message": { "text": "Search term rendered without escaping" },
          "locations": [
            { "physicalLocation": { "artifactLocation": { "uri": "src/search.py" }, "region": { "startLine": 18 } } }
          ]
        },
        {
          "ruleId": "generic.secret.hardcoded",
          "level": "error",
          "message": { "text": "Hard-coded database password" },
          "locations": [
            { "physicalLocation": { "artifactLocation": { "uri": "config/settings.py" }, "region": { "startLine": 3 } } }
          ]
        },
        {
          "ruleId": "generic.secret.hardcoded",
          "level": "error",
          "message": { "text": "Hard-coded test password" },
          "locations": [
            { "physicalLocation": { "artifactLocation": { "uri": "tests/fixtures.py" }, "region": { "startLine": 9 } } }
          ],
          "suppressions": [ { "kind": "external", "status": "accepted", "justification": "test data" } ]
        }
      ]
    }
  ]
}
